{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"target": "es2020",
		"module": "commonjs",
		"lib": ["es2020"],
		"strict": true,
		"sourceMap": true,
		"declaration": true,
		"declarationDir": "dist",
		"outDir": "dist",
		"noImplicitAny": false,
		"esModuleInterop": true,
		"rootDir": ".",
		"types": ["node", "jest"]
	},
	"include": ["src", "index.ts", "jest.ts", "test"],
	"exclude": ["test/**/samples/**"]
}
